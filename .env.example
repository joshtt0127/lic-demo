# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Both values are safe to expose: the anon key only grants what RLS allows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Local scripts only — NEVER commit, never import from src/ ────────────────
# Used by `npm run db:push`, `npm run db:types` and `npm run db:seed`.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Personal access token (https://supabase.com/dashboard/account/tokens).
# Read from ~/.supabase-token when this variable is absent.
SUPABASE_ACCESS_TOKEN=

# Password given to the seeded demo accounts (maya@letitcast.demo, peter@letitcast.demo).
DEMO_PASSWORD=
